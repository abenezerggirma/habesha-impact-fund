# ==============================================================================
# Habesha Impact Fund — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual credentials, API keys, or secrets to version control.

# ------------------------------------------------------------------------------
# Site URL & Canonical Domain
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://habeshaimpact.org"

# ------------------------------------------------------------------------------
# Donation Provider Configuration
# ------------------------------------------------------------------------------
# Supported values: "none" | "stripe_payment_link" | "paypal_hosted" | "external_hosted"
# Leave as "none" until a verified payment provider is configured and approved.
NEXT_PUBLIC_DONATION_PROVIDER="none"

# Hosted Checkout URL for General Fund One-Time Donations (HTTPS required when enabled)
NEXT_PUBLIC_DONATION_GENERAL_URL=""

# Hosted Checkout URL for Monthly Recurring Donations (leave empty unless recurring is supported)
NEXT_PUBLIC_DONATION_MONTHLY_URL=""

# Explicitly set to "true" only when the configured provider supports recurring gifts
NEXT_PUBLIC_DONATION_SUPPORTS_RECURRING="false"

# Optional project-specific hosted checkout overrides
NEXT_PUBLIC_DONATION_CLASSROOM_URL=""
NEXT_PUBLIC_DONATION_CHILDREN_URL=""

# ------------------------------------------------------------------------------
# Tax & Legal Status Configuration
# ------------------------------------------------------------------------------
# Set to "true" ONLY when IRS 501(c)(3) determination letter is officially verified
NEXT_PUBLIC_IRS_501C3_VERIFIED="false"

# Optional EIN (only set when authorized for public display)
NEXT_PUBLIC_ORGANIZATION_EIN=""

# ------------------------------------------------------------------------------
# Contact & Email Delivery (Server-Side Only)
# ------------------------------------------------------------------------------
# Supported values: "none" | "resend" | "webhook"
CONTACT_DELIVERY_PROVIDER="none"

# Destination email address for contact inquiries
CONTACT_RECIPIENT_EMAIL="info@habeshaimpact.org"

# Resend API Key (if CONTACT_DELIVERY_PROVIDER="resend")
RESEND_API_KEY=""

# Webhook URL for form submissions (if CONTACT_DELIVERY_PROVIDER="webhook")
CONTACT_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# Newsletter Configuration
# ------------------------------------------------------------------------------
# Supported values: "none" | "webhook"
NEWSLETTER_PROVIDER="none"
NEWSLETTER_WEBHOOK_URL=""
